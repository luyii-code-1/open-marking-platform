<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OMP.Scanner</AssemblyName>
    <RootNamespace>OMP.Scanner</RootNamespace>
    <StartupObject>OMP.Scanner.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ElectronHost)' == 'true'">
    <OutputType>Exe</OutputType>
    <AssemblyName>OMP.Scanner.Host</AssemblyName>
    <StartupObject>OMP.Scanner.ElectronHost</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
  <ItemGroup Condition="'$(ElectronHost)' == 'true'">
    <Compile Remove="App.xaml.cs;DesktopWindow.xaml.cs;Program.cs" />
    <PackageReference Remove="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="third-party-licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\web\dist\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" Condition="'$(ElectronHost)' != 'true'" />
    <PackageReference Include="NAPS2.Sdk" Version="1.2.1" />
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.2.1" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.2.1" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
  </ItemGroup>
  <Target Name="PublishDevicePlugin" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <DevicePluginProject>$(MSBuildThisFileDirectory)..\scanner-plugins\Hi5100S\Hi5100S.csproj</DevicePluginProject>
    </PropertyGroup>
    <MSBuild Projects="$(DevicePluginProject)" Targets="Restore;Publish" RemoveProperties="ElectronHost;PublishDir" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true" />
    <ItemGroup>
      <DevicePluginFiles Include="$(MSBuildThisFileDirectory)../scanner-plugins/Hi5100S/bin/$(Configuration)/net10.0-windows/win-x64/publish/Hi5100S.*" />
    </ItemGroup>
    <Error Condition="'@(DevicePluginFiles)' == ''" Text="内置扫描插件构建失败" />
    <Copy SourceFiles="@(DevicePluginFiles)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
