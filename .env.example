OMP_DOMAIN=localhost
# Host data directory mounted by API, worker and scheduler.
OMP_HOST_DATA=./data
OMP_STORAGE=local
OMP_STORAGE_PREFIX=omp
# Passkey: default RP ID follows OMP_DOMAIN; set exact HTTPS origins if needed.
# OMP_RP_ID=marking.example.com
# OMP_WEBAUTHN_ORIGINS=https://marking.example.com
# WebSocket origins default to HTTPS OMP_DOMAIN; list exact origins for a separate frontend.
# OMP_WS_ORIGINS=https://marking.example.com
# s3 / ros
# OMP_S3_ENDPOINT=https://your-storage-endpoint
# OMP_S3_BUCKET=omp
# OMP_S3_ACCESS_KEY=
# OMP_S3_SECRET_KEY=
# OMP_S3_REGION=us-east-1
# OMP_S3_ADDRESSING=path
# webdav
# OMP_WEBDAV_URL=https://your-webdav-endpoint/path
# OMP_WEBDAV_USER=
# OMP_WEBDAV_PASSWORD=
# sftp: install trusted server host keys into known_hosts
# OMP_SFTP_HOST=
# OMP_SFTP_PORT=22
# OMP_SFTP_USER=
# OMP_SFTP_PASSWORD=
# OMP_SFTP_ROOT=/omp
# OMP_SFTP_KNOWN_HOSTS=/data/known_hosts
